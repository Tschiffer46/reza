# /home/deploy/hosting/.env.vadskavi  (per-app secrets, gitignorerad på servern)
# Delas mellan tjänsterna `vadskavi` och `vadskavi-db`.
#
# Generera lösenord:
#   openssl rand -hex 24      → POSTGRES_PASSWORD (och samma värde i DATABASE_URL)
#   openssl rand -base64 32   → AUTH_SECRET

NODE_ENV=production

# OBS: lösenordet här måste matcha det i DATABASE_URL nedan
POSTGRES_PASSWORD=CHANGE_ME_db
DATABASE_URL=postgresql://vadskavi:CHANGE_ME_db@vadskavi-db:5432/vadskavi

# Auth.js
AUTH_SECRET=CHANGE_ME_min_32_tecken
AUTH_URL=https://vadskavi.nu
AUTH_TRUST_HOST=true

# Magic link / SMTP (Mailcow)
EMAIL_SERVER_HOST=mail.schiffer.se
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@vadskavi.nu
EMAIL_SERVER_PASSWORD=CHANGE_ME_smtp
EMAIL_FROM=VadSkaVi <noreply@vadskavi.nu>

# Anthropic (krävs för AI-extraktion i Sprint 2)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
