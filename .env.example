# ---- Databas ----
# Lokalt: peka mot din egen postgres. På servern: mot vadskavi-db-containern.
DATABASE_URL=postgresql://vadskavi:CHANGE_ME@localhost:5432/vadskavi

# ---- Auth.js v5 ----
# Generera med: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_min_32_tecken
# Publik bas-URL (krävs av Auth.js i produktion bakom proxy)
AUTH_URL=https://vadskavi.nu
# Behåll true bakom Nginx Proxy Manager
AUTH_TRUST_HOST=true

# ---- OAuth: Logga in med Google ----
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://vadskavi.nu/api/auth/callback/google
AUTH_GOOGLE_ID=CHANGE_ME
AUTH_GOOGLE_SECRET=CHANGE_ME

# ---- OAuth: Logga in med Apple ----
# Apple Developer → Identifiers → Services ID (= AUTH_APPLE_ID), Key (Sign in with Apple).
# Return URL: https://vadskavi.nu/api/auth/callback/apple
# AUTH_APPLE_SECRET är en signerad JWT (giltig ≤ 6 mån) genererad från Apple-nyckeln.
AUTH_APPLE_ID=CHANGE_ME
AUTH_APPLE_SECRET=CHANGE_ME

# ---- Magic link / SMTP (Mailcow) ----
EMAIL_SERVER_HOST=mail.schiffer.se
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@vadskavi.nu
EMAIL_SERVER_PASSWORD=CHANGE_ME
EMAIL_FROM="VadSkaVi <noreply@vadskavi.nu>"

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ---- Bilduppladdning ----
UPLOAD_DIR=./data/uploads
