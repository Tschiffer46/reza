// VadSkaVi — Prisma-schema (Sprint 1)
// Datamodell enligt task-spec: Auth.js-tabeller + familj/recept-domän.

generator client {
  provider      = "prisma-client-js"
  // linux-musl-target krävs för Prisma i node:20-alpine-containern (jfr stegvis-app)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  avatar        String?
  // Auth.js PrismaAdapter skriver OAuth-profilbilden till `image` (standardfält).
  // Appen visar `avatar`; `image` finns för att adaptern ska kunna skapa OAuth-konton.
  image         String?
  bio           String?
  password      String?
  plan          String       @default("free")
  isAdmin       Boolean      @default(false)
  // Extra recept utöver gratis månadskvoten (välkomstbonus + ev. kompensation
  // tilldelad av admin). Förbrukas när månadskvoten är slut. Se src/lib/plan.ts.
  bonusCredits  Int          @default(15)
  emailVerified DateTime?
  onboardedAt   DateTime?
  // Senast användaren öppnade Snack — används för olästa @-omnämnanden.
  snackSeenAt   DateTime?
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  recipes       Entry[]      @relation("Creator")
  comments      Comment[]
  notes         Note[]
  reactions     Reaction[]
  ratings       Rating[]
  changes       ChangeLog[]
  accounts      Account[]
  sessions      Session[]
  feedback      Feedback[]
  posts         Post[]
  postReplies   PostReply[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Family {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  status      String       @default("active")
  background  String?
  coverImage  String?
  createdAt   DateTime     @default(now())
  createdById String
  members     Membership[]
  entries     Entry[]
  categories  Category[]
  posts       Post[]
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  familyId String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  family   Family   @relation(fields: [familyId], references: [id])

  @@unique([userId, familyId])
}

model Entry {
  id           String      @id @default(cuid())
  type         String
  title        String
  category     String
  blurb        String?
  time         String?
  servings     Int?
  ingredients  String[]
  instructions String?
  content      String?
  drinks       String?
  source       String?
  url          String?
  imageUrls    String[]    @default([])
  searchVector Unsupported("tsvector")?
  timesCooked  Int         @default(0)
  ratingAvg    Float?
  ratingCount  Int         @default(0)
  lastCooked   DateTime?
  createdAt    DateTime    @default(now())
  familyId     String
  creatorId    String
  family       Family      @relation(fields: [familyId], references: [id])
  creator      User        @relation("Creator", fields: [creatorId], references: [id])
  comments     Comment[]
  notes        Note[]
  reactions    Reaction[]
  ratings      Rating[]
  changes      ChangeLog[]
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  createdAt DateTime @default(now())
  entryId   String
  userId    String
  entry     Entry    @relation(fields: [entryId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([entryId, userId])
}

model Note {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  entryId   String
  authorId  String
  entry     Entry    @relation(fields: [entryId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Reaction {
  id      String @id @default(cuid())
  entryId String
  userId  String
  entry   Entry  @relation(fields: [entryId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([entryId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  entryId   String
  authorId  String
  entry     Entry    @relation(fields: [entryId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model ChangeLog {
  id        String   @id @default(cuid())
  action    String
  field     String?
  createdAt DateTime @default(now())
  entryId   String
  userId    String
  entry     Entry    @relation(fields: [entryId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Category {
  id       String @id @default(cuid())
  name     String
  type     String
  familyId String
  family   Family @relation(fields: [familyId], references: [id])
}

/**
 * Medlemssnack: en enkel anslagstavla per gemenskap. Inlägg göms/raderas efter
 * 7 dagar (filtreras vid läsning + opportunistisk rensning). Betalande medlemmar
 * kan ta bort andras inlägg/svar; alla kan ta bort sina egna.
 */
model Post {
  id        String      @id @default(cuid())
  familyId  String
  authorId  String
  text      String
  mentions  String[]    @default([])
  createdAt DateTime    @default(now())
  family    Family      @relation(fields: [familyId], references: [id])
  author    User        @relation(fields: [authorId], references: [id])
  replies   PostReply[]
}

model PostReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String   @default("other")
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
